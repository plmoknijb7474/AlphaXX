APP_NAME=AlphaX
ENVIRONMENT=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Local development: sqlite:///./alpha.db
# Local development (keep this for SQLite deployments):
DATABASE_URL=sqlite:///./alpha.db
# Production on Render: set DATABASE_URL to the Render PostgreSQL Internal Database URL.
# Keep this SQLite URL for local development.
# Supabase migration tools remain available for legacy data migration; they do not run automatically.
PUBLIC_BASE_URL=https://YOUR-ALPHAX-DOMAIN.example
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
COOKIE_SECURE=false
# Required for encrypting each customer/model provider key and one-time AlphaX key reveal.
# APInex, Regolo, OpenRouter, and Google AI Studio keys are stored per customer/model.
# Do not add global upstream API keys to Render Environment; admin manages encrypted per-model keys.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_WITH_A_GENERATED_FERNET_KEY
DAILY_QUOTA_TIMEZONE=UTC
PAYMENT_REVIEW_TIMEZONE=Asia/Damascus
