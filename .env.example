APP_NAME=AlphaX
ENVIRONMENT=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Local development: sqlite:///./alpha.db
# Local development (keep this for SQLite deployments):
DATABASE_URL=sqlite:///./alpha.db
# Configure Supabase interactively from Bash with: python scripts/configure_supabase.py
# The helper prompts for the URI (hidden), tests SSL connectivity, backs up this file,
# then writes DATABASE_URL only if the Supabase public schema is empty.
# Session Pooler is recommended (usually port 5432).
PUBLIC_BASE_URL=https://YOUR-ALPHAX-DOMAIN.example
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
COOKIE_SECURE=false
# Required for encrypting each user's private upstream key and one-time AlphaX key reveal.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_WITH_A_GENERATED_FERNET_KEY
DAILY_QUOTA_TIMEZONE=UTC
PAYMENT_REVIEW_TIMEZONE=Asia/Damascus
